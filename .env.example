# Tresorpost — server configuration.
# Copy to `.env` and adjust. All values are optional; defaults are shown.

# Maximum attachment size in megabytes (Image / File types) for the SQLite path.
MAX_FILE_MB=5

# Maximum notes created per client IP per window. 0 disables.
# CREATE_RATE_LIMIT=60
# CREATE_RATE_WINDOW_SECS=3600
# Set TRUST_PROXY=true only behind nginx/Caddy that sets X-Forwarded-For.
# TRUST_PROXY=false

# HTTP port.
PORT=3000

# SQLite database file path.
DATABASE_PATH=db/data.db

# Directory of the built frontend to serve.
STATIC_DIR=frontend/dist

RUST_LOG=tresorpost=info,tower_http=info

# ── Large files via S3 (optional) ───────────────────────────
# When these are unset, Tresorpost keeps small files in SQLite.
# When configured, file uploads stream directly from the browser to S3 via
# presigned multipart URLs (up to ~5 GB), fully end-to-end encrypted.
#
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=tresorpost
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin
# S3_FORCE_PATH_STYLE=true
# MAX_S3_FILE_MB=5120
# S3_URL_TTL_SECS=3600
